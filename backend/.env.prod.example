# ─────────────────────────────────────────────────────────────────────────────
# Production environment template for docker-compose.prod.yml.
#
#   cp backend/.env.prod.example .env.prod   # at repo root, next to the compose
#   # then fill in REAL secrets — NEVER commit the filled-in .env.prod
#
# Generate a strong SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=deporte
POSTGRES_USER=deporte
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ── App ──────────────────────────────────────────────────────────────────────
# Must be long & random. Tokens signed with this — rotating it logs everyone out.
SECRET_KEY=CHANGE_ME_run_the_token_urlsafe_command_above
ENVIRONMENT=production

# Host port the API is published on (container always listens on 8000).
API_PORT=8000

# Gunicorn worker processes per API container.
WEB_CONCURRENCY=2

# Comma-separated allowed CORS origins (your frontend's real domain).
ALLOWED_ORIGINS=https://app.your-domain.com

# ── 2FA (TOTP) + encryption at rest ────────────────────────────────────────────
MFA_ISSUER=Deporte FC
# Force admins/super-admins to enrol in 2FA (UI flag; never hard-locks login).
MFA_REQUIRED_FOR_ADMINS=true
# REQUIRED in prod. Encrypts 2FA secrets and protected health data at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or rotating this makes existing ciphertext unreadable — back it up securely.
DATA_ENCRYPTION_KEY=CHANGE_ME_run_the_fernet_generate_key_command

# ── AI / external services ───────────────────────────────────────────────────
GROQ_API_KEY=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Deporte FC <noreply@your-domain.com>
EMAIL_ALERTS_ENABLED=false

# ── Backups ──────────────────────────────────────────────────────────────────
# How often to dump, and how many days of dumps to keep.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
