# ── BASE DE DATOS ────────────────────────────────────────────────────────────
# Railway inyecta DATABASE_URL automáticamente al agregar un servicio PostgreSQL.
# Para desarrollo local usa SQLite (ya es el default en config.py):
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── SEGURIDAD JWT ─────────────────────────────────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 2FA (TOTP) + CIFRADO AT-REST ──────────────────────────────────────────────
# Etiqueta mostrada en la app de autenticación (Google Authenticator, Authy, …).
MFA_ISSUER=Deporte FC
# Obliga a admins/super-admins a inscribir 2FA (flag de UI, no bloquea el login).
MFA_REQUIRED_FOR_ADMINS=true
# Clave Fernet para cifrar columnas sensibles (secretos 2FA, datos de salud).
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si se deja vacío, se deriva de SECRET_KEY (solo desarrollo).
DATA_ENCRYPTION_KEY=

# ── CORS (frontend URL en Railway) ────────────────────────────────────────────
# Múltiples orígenes separados por coma
ALLOWED_ORIGINS=https://tu-frontend.railway.app,https://tu-dominio-custom.com

# ── EMAIL / SMTP ──────────────────────────────────────────────────────────────
# Para activar alertas por email: EMAIL_ALERTS_ENABLED=true
EMAIL_ALERTS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
# Usar "contraseña de aplicación" de Google, no la contraseña normal
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=Deporte FC <tu-email@gmail.com>

# ── IA TÁCTICA (Groq) ─────────────────────────────────────────────────────────
# Obtener en: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ── ENTORNO ───────────────────────────────────────────────────────────────────
ENVIRONMENT=production
